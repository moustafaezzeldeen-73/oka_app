{%- comment -%} SubscribeScreen.js — the subscription builder (create and edit). {%- endcomment -%}
<div class="screen fade-in" data-screen="subscribe">
  <div data-sub-header>{% render 'screen-header', en: 'Subscribe & Save', ar: 'الاشتراك والتوفير', back: '/pages/subscriptions' %}</div>
  {%- if customer -%}
    <div data-subscribe-root></div>
  {%- else -%}
    <a href="{{ routes.account_login_url }}" class="notice press s99" data-sign-in="/pages/subscriptions?view=oka-subscribe">{% render 'bi', en: 'Sign in to start a recurring delivery subscription.', ar: 'سجّل دخولك عشان تقدر تبدأ اشتراك توصيل متكرر.' %}</a>
  {%- endif -%}
</div>
{% schema %}{ "name": "Subscribe & Save", "tag": "div" }{% endschema %}
