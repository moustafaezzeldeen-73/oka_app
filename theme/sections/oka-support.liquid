{%- comment -%}
  SupportScreen.js — WhatsApp, answers, policies. Delivery fees in the
  answers come from Theme settings, so they never disagree with the cart.
{%- endcomment -%}
{%- liquid
  assign t = settings.tier_threshold
  assign mo = settings.min_order
-%}
{%- capture metro -%}<span class="nums">{% render 'price', egp: settings.fee_metro_under %} / {% render 'price', egp: settings.fee_metro_over %}</span>{%- endcapture -%}
{%- capture delta -%}<span class="nums">{% render 'price', egp: settings.fee_delta_under %} / {% render 'price', egp: settings.fee_delta_over %}</span>{%- endcapture -%}
{%- capture far -%}<span class="nums">{% render 'price', egp: settings.fee_far_under %} / {% render 'price', egp: settings.fee_far_over %}</span>{%- endcapture -%}
<div class="screen fade-in" data-screen="support">
  {% render 'screen-header', en: 'Help & support', ar: 'محتاج مساعدة؟', back: '/pages/account' %}

  {%- if settings.whatsapp != blank -%}
    <a class="wa-btn" data-wa-chat{% if customer and customer.orders.first %} data-last-order="{{ customer.orders.first.name | escape }}"{% endif %} href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">
      {% render 'icon', name: 'whatsapp', px: 18 %}
      {% render 'bi', en: 'Chat with us on WhatsApp', ar: 'كلّمنا على واتساب' %}
    </a>
  {%- endif -%}

  <div class="support-section">{% render 'bi', en: 'Common questions', ar: 'أسئلة بتتسأل كتير' %}</div>

  <div class="qa">
    <div class="qa-q">{% render 'bi', en: 'How long does delivery take?', ar: 'التوصيل بياخد قد إيه؟' %}</div>
    <div class="qa-a">{% render 'bi', en: 'Cairo, Giza and Alexandria: 1–2 days. Delta and Canal: 2–3 days. Upper Egypt, Sinai, Red Sea and Matrouh: 3–5 days.', ar: 'القاهرة والجيزة والإسكندرية: ١-٢ يوم. الدلتا والقناة: ٢-٣ أيام. الصعيد وسيناء والبحر الأحمر ومطروح: ٣-٥ أيام.' %}</div>
    <div class="divider"></div>
  </div>
  <div class="qa">
    <div class="qa-q">{% render 'bi', en: 'How much is delivery?', ar: 'التوصيل بكام؟' %}</div>
    <div class="qa-a">
      <span class="l-en">The same as our website: Cairo, Giza and Alexandria {{ metro }}; Delta and Canal {{ delta }}; everywhere else {{ far }}. The lower fee applies to orders of {% render 'price', egp: t %} or more.{% if mo > 0 %} The minimum order is {% render 'price', egp: mo %}.{% endif %}</span>
      <span class="l-ar">نفس أسعار موقعنا: القاهرة والجيزة والإسكندرية {{ metro }}، الدلتا والقناة {{ delta }}، وباقي المحافظات {{ far }}. الرسوم الأقل للطلبات من {% render 'price', egp: t %}.{% if mo > 0 %} أقل طلب {% render 'price', egp: mo %}.{% endif %}</span>
    </div>
    <div class="divider"></div>
  </div>
  <div class="qa">
    <div class="qa-q">{% render 'bi', en: 'How do I pay?', ar: 'بدفع إزاي؟' %}</div>
    <div class="qa-a">{% render 'bi', en: 'Cash on delivery. Please have the exact amount ready for the courier.', ar: 'بتدفع كاش لما الطلب يوصلك. جهّز المبلغ للمندوب لو سمحت.' %}</div>
    <div class="divider"></div>
  </div>
  <div class="qa">
    <div class="qa-q">{% render 'bi', en: 'Can I change or cancel my order?', ar: 'أقدر أعدّل أو ألغي طلبي؟' %}</div>
    <div class="qa-a">{% render 'bi', en: 'Yes, from the Orders tab, until it has been handed to the courier.', ar: 'أيوه، من صفحة طلباتي، طول ما الطلب لسه متسلمش للمندوب.' %}</div>
    <div class="divider"></div>
  </div>
  <div class="qa">
    <div class="qa-q">{% render 'bi', en: 'How do loyalty points work?', ar: 'نقاط الولاء بتشتغل إزاي؟' %}</div>
    <div class="qa-a">{% render 'bi', en: 'You earn 1 point for every EGP of products once your order is delivered (10 points = 1 EGP). Redeem points for discount codes from the Loyalty screen.', ar: 'بتاخد نقطة على كل جنيه منتجات لما طلبك يوصل (١٠ نقاط = ١ جنيه). بدّل نقاطك بأكواد خصم من صفحة النقاط.' %}</div>
    <div class="divider"></div>
  </div>
  <div class="qa">
    <div class="qa-q">{% render 'bi', en: 'What if something arrives damaged?', ar: 'لو حاجة وصلت مكسورة؟' %}</div>
    <div class="qa-a">{% render 'bi', en: 'Message us on WhatsApp within 48 hours with a photo and your order number and we’ll replace it.', ar: 'ابعتلنا على واتساب في خلال ٤٨ ساعة بصورة ورقم الطلب وإحنا نبدّلهالك.' %}</div>
  </div>

  <div class="support-section" id="legal">{% render 'bi', en: 'Policies', ar: 'الشروط والسياسات' %}</div>
  {%- if shop.refund_policy -%}<a class="policy" href="{{ shop.refund_policy.url }}">{% render 'bi', en: 'Returns & refunds', ar: 'الاسترجاع ورجوع فلوسك' %}</a>{%- endif -%}
  {%- if shop.shipping_policy -%}<a class="policy" href="{{ shop.shipping_policy.url }}">{% render 'bi', en: 'Shipping', ar: 'الشحن' %}</a>{%- endif -%}
  {%- if shop.privacy_policy -%}<a class="policy" href="{{ shop.privacy_policy.url }}">{% render 'bi', en: 'Privacy', ar: 'الخصوصية' %}</a>{%- endif -%}
  {%- if shop.terms_of_service -%}<a class="policy" href="{{ shop.terms_of_service.url }}">{% render 'bi', en: 'Terms of service', ar: 'شروط الاستخدام' %}</a>{%- endif -%}
  <div style="height:30px"></div>
</div>
{% schema %}{ "name": "Support", "tag": "div" }{% endschema %}
