{%- comment -%}
  HomeScreen.js — the collection feed.

  Vertical: one page per collection (CSS scroll-snap y mandatory — what the
  prototype used, and what the app's pagingEnabled reproduces).
  Horizontal: one notch per product. The selector strip is bound to the feed:
  the glass lens is fixed at the centre and the strip slides beneath it.
  Behaviour lives in assets/oka-screens.js (screen "home").
{%- endcomment -%}
{%- liquid
  if settings.logo
    assign logo_url = settings.logo | image_url: width: 128
  else
    assign logo_url = 'oka-logo.png' | asset_url
  endif
-%}
<div class="home fade-in" data-screen="home">
  <header class="home-hdr">
    <div class="home-row">
      <button class="circle-34 press s94" data-menu-open aria-label="Menu" aria-controls="side-menu" aria-expanded="false">{% render 'icon', name: 'menu', px: 17 %}</button>
      <img src="{{ logo_url }}" alt="{{ shop.name }}" class="home-logo" width="32" height="32">
      <button class="circle-34 press s94" data-toggle-lang><span data-lang-label>{% if settings.default_lang == 'ar' %}EN{% else %}ع{% endif %}</span></button>
    </div>

    <div class="nav-wrap">
      <div class="lens"></div>
      <div class="nav-strip hscroll" data-nav>
        <button class="nav-item active" data-i="0" aria-label="Offers">
          <span class="nav-icon"><span class="nav-offers">{% render 'icon', name: 'tag', px: 24, color: '#ffffff' %}</span></span>
        </button>
        {%- for c in settings.oka_collections -%}
          {%- liquid
            if c.image
              assign img = c.image
            else
              assign img = c.products.first.featured_image
            endif
          -%}
          <button class="nav-item" data-i="{{ forloop.index }}" aria-label="{{ c.title | escape }}">
            <span class="nav-icon">{% if img %}{{ img | image_url: width: 160 | image_tag: alt: '', loading: 'eager' }}{% endif %}</span>
          </button>
        {%- endfor -%}
      </div>
    </div>
  </header>

  <div class="feed" data-feed>
    {%- comment -%} Page 0 — the promo carousel. {%- endcomment -%}
    <section class="page active" data-i="0" data-nav="0">
      <h2 class="page-title">{% render 'bi', en: 'Offers', ar: 'العروض' %}</h2>
      <div class="rail offers hscroll" data-rail>
        {%- assign offer_n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'offer' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign offer_n = offer_n | plus: 1
            assign ratio = 0.88
            assign iw = 264
            assign ih = 300
            if block.settings.image
              assign src = block.settings.image | image_url: width: 700
              assign ratio = block.settings.image.aspect_ratio
              assign iw = block.settings.image.width
              assign ih = block.settings.image.height
            elsif block.settings.bundled_image != blank
              assign src = block.settings.bundled_image | asset_url
            else
              assign src = ''
            endif
            assign link = block.settings.collection.url | default: routes.collections_url
            assign offer_variant = block.settings.product.selected_or_first_available_variant
            assign bundle = block.settings.variant_ids | remove: ' '
          -%}
          {%- comment -%}
            The card takes the banner's own shape (a 2:3 bundle poster, a square
            promo) inside the rail's 264×300 box, so no banner is cropped or
            letterboxed on white.
          {%- endcomment -%}
          <div class="offer-slot{% if offer_n == 1 %} active{% endif %}" data-slot style="--ratio: {{ ratio }}" {{ block.shopify_attributes }}>
            <a href="{{ link }}" class="offer-card">{% if src != '' %}<img src="{{ src }}" alt="" width="{{ iw }}" height="{{ ih }}" loading="{% if offer_n < 3 %}eager{% else %}lazy{% endif %}">{% endif %}</a>
            {%- if bundle != blank -%}
              <button class="offer-cta" data-add-bundle="{{ bundle }}">{% render 'bi', en: block.settings.button_en, ar: block.settings.button_ar %}</button>
            {%- elsif offer_variant -%}
              <button class="offer-cta" data-add="{{ offer_variant.id }}">{% render 'bi', en: 'Add to Cart', ar: 'أضف إلى السلة' %}</button>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </section>

    {%- comment -%}
      Graphic banners sit where they sit on the original website: each one is
      its own page just before the collection it introduced there. A banner
      whose collection isn't in the feed follows the Offers page.
    {%- endcomment -%}
    {%- assign feed_handles = ',' -%}
    {%- for c in settings.oka_collections -%}{%- assign feed_handles = feed_handles | append: c.handle | append: ',' -%}{%- endfor -%}
    {%- for block in section.blocks -%}
      {%- if block.type != 'banner' -%}{%- continue -%}{%- endif -%}
      {%- assign probe = ',' | append: block.settings.before.handle | append: ',' -%}
      {%- unless feed_handles contains probe -%}{%- render 'banner-page', block: block, nav: 0 -%}{%- endunless -%}
    {%- endfor -%}

    {%- comment -%} Pages 1..n — one rail per collection; a product shows under the first collection that has it. {%- endcomment -%}
    {%- assign seen = ',' -%}
    {%- for c in settings.oka_collections -%}
      {%- assign nav_i = forloop.index -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'banner' and block.settings.before.handle == c.handle -%}
          {%- render 'banner-page', block: block, nav: nav_i -%}
        {%- endif -%}
      {%- endfor -%}
      <section class="page" data-i="{{ forloop.index }}" data-nav="{{ forloop.index }}">
        <h2 class="page-title anim">{% render 'ctitle', c: c %}</h2>
        <div class="rail prods hscroll" data-rail>
          {%- assign first = true -%}
          {%- for p in c.products limit: 50 -%}
            {%- assign probe = ',' | append: p.handle | append: ',' -%}
            {%- if seen contains probe -%}{%- continue -%}{%- endif -%}
            {%- assign seen = seen | append: p.handle | append: ',' -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            <div class="prod-slot{% if first %} active{% endif %}" data-slot>
              <a href="{{ p.url }}" class="prod-card" data-tap data-variant="{{ v.id }}"{% unless p.available %} data-soldout{% endunless %}>
                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: alt: p.title, loading: 'lazy', draggable: 'false' }}{%- endif -%}
              </a>
              <div class="prod-meta">
                <div class="prod-title">{% render 'ptitle', p: p %}</div>
                <div class="prod-price">{% render 'price', cents: v.price %}</div>
                <div class="prod-actions">
                  <button class="add-34" data-add="{{ v.id }}"{% unless p.available %} data-soldout{% endunless %} aria-label="Add">+</button>
                  <button class="ar-pill" data-ar="{{ p.handle }}">
                    {% render 'icon', name: 'cube', px: 15 %}
                    {% render 'bi', en: 'See it on your table', ar: 'شوفها على طرابيزتك' %}
                  </button>
                </div>
              </div>
            </div>
            {%- assign first = false -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "OKA feed",
  "tag": "div",
  "class": "home-section",
  "max_blocks": 30,
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "bundled_image", "label": "Bundled image (theme asset)", "info": "Used when no image is picked, e.g. promo1.jpg" },
        { "type": "collection", "id": "collection", "label": "Opens collection" },
        { "type": "product", "id": "product", "label": "Add to Cart adds", "info": "One product. Ignored when bundle variant IDs are set." },
        { "type": "text", "id": "variant_ids", "label": "Bundle variant IDs", "info": "Comma-separated. The button adds all of them at once — the website's bundle offers." },
        { "type": "text", "id": "button_en", "label": "Bundle button (English)", "default": "Add bundle to cart" },
        { "type": "text", "id": "button_ar", "label": "Bundle button (Arabic)", "default": "أضف العرض للسلة" }
      ]
    },
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "before", "label": "Show before collection", "info": "The banner gets its own page just before this collection. Not in the feed: it follows the Offers page." },
        { "type": "url", "id": "link", "label": "Opens", "info": "Defaults to the collection above." },
        { "type": "text", "id": "variant_ids", "label": "Bundle variant IDs (optional)", "info": "Comma-separated. Adds a button that puts all of them in the cart." },
        { "type": "text", "id": "button_en", "label": "Button (English)", "default": "Add to Cart" },
        { "type": "text", "id": "button_ar", "label": "Button (Arabic)", "default": "أضف إلى السلة" }
      ]
    }
  ],
  "presets": [{ "name": "OKA feed" }]
}
{% endschema %}
