<div class="screen fade-in" style="display:flex;flex-direction:column;justify-content:center">
  <div style="display:flex;justify-content:center;margin-bottom:22px"><img src="{{ 'oka-logo.png' | asset_url }}" alt="{{ shop.name }}" width="126" height="48" style="height:48px;width:auto"></div>
  {%- if shop.password_message != blank -%}<p class="lead" style="text-align:center;padding:0 22px">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'signin' -%}
    <input class="field-input" type="password" name="password" placeholder="Password" dir="ltr" required>
    {%- if form.errors -%}<div class="error-txt">{{ form.errors | default_errors }}</div>{%- endif -%}
    <button class="cta" type="submit">Enter</button>
  {%- endform -%}
</div>
{% schema %}{ "name": "Password", "tag": "div" }{% endschema %}
