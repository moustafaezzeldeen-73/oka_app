{%- comment -%}
  SignInScreen.js. The app signs in with a one-time code on WhatsApp through
  the order service; on the web, Shopify's own customer accounts do it.
  This is the classic-accounts form; with new customer accounts Shopify hosts
  sign-in (email one-time code) and this template is never shown.
{%- endcomment -%}
<div class="screen fade-in" data-screen="login">
  {% render 'screen-header', en: 'Sign in', ar: 'سجّل دخول' %}
  <div class="signin" data-login-panel>
    <p class="lead">{% render 'bi', en: 'Sign in with your email. Your orders, points and addresses follow you.', ar: 'ادخل بإيميلك. طلباتك ونقاطك وعناوينك هتكون معاك.' %}</p>
    {%- form 'customer_login', class: 'signin', style: 'padding:0' -%}
      <label class="field-label">{% render 'bi', en: 'Email', ar: 'الإيميل' %}</label>
      <input class="field-input" type="email" name="customer[email]" autocomplete="email" dir="ltr" required placeholder="name@example.com">
      <label class="field-label">{% render 'bi', en: 'Password', ar: 'كلمة السر' %}</label>
      <input class="field-input" type="password" name="customer[password]" autocomplete="current-password" dir="ltr" required placeholder="••••••">
      {%- if form.errors -%}<div class="error-txt">{{ form.errors | default_errors }}</div>{%- endif -%}
      <button class="cta" type="submit" style="margin-top:8px">{% render 'bi', en: 'Sign in', ar: 'سجّل دخول' %}</button>
    {%- endform -%}
    <a href="{{ routes.account_register_url }}" class="signin-link">{% render 'bi', en: 'New here? Create an account', ar: 'أول مرة؟ اعمل حساب' %}</a>
    <button class="signin-link" data-show-recover>{% render 'bi', en: 'Forgot your password?', ar: 'نسيت كلمة السر؟' %}</button>
  </div>
  <div class="signin" data-recover-panel hidden>
    {%- form 'recover_customer_password', class: 'signin', style: 'padding:0' -%}
      <p class="lead">{% render 'bi', en: 'We’ll email you a link to set a new password.', ar: 'هنبعتلك لينك على الإيميل تغيّر بيه كلمة السر.' %}</p>
      {%- if form.posted_successfully? -%}<div class="soft-notice">{% render 'bi', en: 'Check your email for the link.', ar: 'شوف الإيميل، بعتنالك اللينك.' %}</div>{%- endif -%}
      <label class="field-label">{% render 'bi', en: 'Email', ar: 'الإيميل' %}</label>
      <input class="field-input" type="email" name="email" autocomplete="email" dir="ltr" required>
      {%- if form.errors -%}<div class="error-txt">{{ form.errors | default_errors }}</div>{%- endif -%}
      <button class="cta" type="submit" style="margin-top:8px">{% render 'bi', en: 'Send link', ar: 'ابعت اللينك' %}</button>
    {%- endform -%}
    <button class="signin-link" data-show-login>{% render 'bi', en: 'Back to sign in', ar: 'ارجع لتسجيل الدخول' %}</button>
  </div>
</div>
{% schema %}{ "name": "Sign in", "tag": "div" }{% endschema %}
