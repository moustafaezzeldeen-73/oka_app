{%- comment -%}
  AddressesScreen.js. Tapping a card chooses where the next order ships;
  "Make default" and "Delete" are separate, explicit actions.
{%- endcomment -%}
<div class="screen fade-in" data-screen="addresses">
  {% render 'screen-header', en: 'My addresses', ar: 'عناويني', back: '/pages/account' %}
  {%- if customer -%}
    {%- if customer.addresses.size == 0 -%}
      <div class="empty" style="color:var(--ink-soft)">{% render 'bi', en: 'No saved addresses yet', ar: 'لا توجد عناوين محفوظة' %}</div>
    {%- endif -%}
    {%- for a in customer.addresses -%}
      {%- assign is_default = false -%}
      {%- if a.id == customer.default_address.id -%}{%- assign is_default = true -%}{%- endif -%}
      <div class="addr-card" data-addr="{{ a.id }}" data-province="{{ a.province_code }}" data-default="{{ is_default }}" role="button" tabindex="0">
        <div class="addr-inner">
          <div style="flex:1;min-width:0">
            <div class="addr-labelrow">
              <span class="addr-label" data-addr-label><span class="l-en">Address {{ forloop.index }}</span><span class="l-ar">عنوان {% render 'ar-digits', s: forloop.index %}</span></span>
              {%- if is_default -%}<span class="addr-badge">{% render 'bi', en: 'Default', ar: 'الافتراضي' %}</span>{%- endif -%}
            </div>
            <div class="addr-line">{{ a.name | default: customer.name }}</div>
            <div class="addr-line">{{ a.address1 }}{% if a.address2 != blank %}, {{ a.address2 }}{% endif %}</div>
            <div class="addr-line">{{ a.city }}</div>
            {%- assign ph = a.phone | default: customer.phone -%}
            {%- if ph != blank -%}<div class="addr-line" style="letter-spacing:.5px"><span class="nums">{{ ph }}</span></div>{%- endif -%}
            <div class="addr-eta"><span class="l-en">Delivery in <span data-eta></span></span><span class="l-ar">التوصيل خلال <span data-eta></span></span></div>
            <div class="addr-actions">
              {%- unless is_default -%}<button class="addr-action" data-make-default>{% render 'bi', en: 'Make default', ar: 'اجعله الافتراضي' %}</button>{%- endunless -%}
              <button class="addr-action red" data-delete-addr>{% render 'bi', en: 'Delete', ar: 'حذف' %}</button>
            </div>
          </div>
          <span class="radio lg"></span>
        </div>
      </div>
    {%- endfor -%}
    <div style="padding:6px 22px 30px">
      <a href="/pages/addresses?view=oka-add-address" class="outline-btn">{% render 'icon', name: 'plus', size: 16 %}{% render 'bi', en: 'Add new address', ar: 'إضافة عنوان جديد' %}</a>
    </div>
  {%- else -%}
    <a href="{{ routes.account_login_url }}" class="notice" data-sign-in="/pages/addresses">{% render 'bi', en: 'Sign in to see your saved addresses.', ar: 'سجّل دخولك عشان تشوف عناوينك المحفوظة.' %}</a>
  {%- endif -%}
</div>
{% schema %}{ "name": "Addresses", "tag": "div" }{% endschema %}
