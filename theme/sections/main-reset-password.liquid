{%- capture fields -%}
  <label class="field-label">{% render 'bi', en: 'Password', ar: 'كلمة السر' %}</label>
  <input class="field-input" type="password" name="customer[password]" autocomplete="new-password" dir="ltr" required>
  <label class="field-label">{% render 'bi', en: 'Confirm password', ar: 'اكتب كلمة السر تاني' %}</label>
  <input class="field-input" type="password" name="customer[password_confirmation]" autocomplete="new-password" dir="ltr" required>
{%- endcapture -%}
{%- capture submit -%}<button class="cta" type="submit" style="margin-top:8px">{% render 'bi', en: 'Save', ar: 'احفظ' %}</button>{%- endcapture -%}
<div class="screen fade-in" data-screen="reset">
  {% render 'screen-header', en: 'New password', ar: 'كلمة سر جديدة', back: routes.account_login_url %}
  {%- if template.name == 'activate_account' -%}
    {%- form 'activate_customer_password', class: 'signin' -%}
      {{ fields }}
      {%- if form.errors -%}<div class="error-txt">{{ form.errors | default_errors }}</div>{%- endif -%}
      {{ submit }}
    {%- endform -%}
  {%- else -%}
    {%- form 'reset_customer_password', class: 'signin' -%}
      {{ fields }}
      {%- if form.errors -%}<div class="error-txt">{{ form.errors | default_errors }}</div>{%- endif -%}
      {{ submit }}
    {%- endform -%}
  {%- endif -%}
</div>
{% schema %}{ "name": "Password", "tag": "div" }{% endschema %}
