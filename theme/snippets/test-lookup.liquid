{%- comment -%}
  ─────────────────────────────────────────────────────────────────────────
   TESTING ONLY — staff J&T lookup.  REMOVE BEFORE PUBLISHING.
  ─────────────────────────────────────────────────────────────────────────
  Finds a customer's J&T shipments by phone, or tracks AWB numbers, through
  the website tracking service (Theme settings →
  Live J&T tracking): status, scan history and the courier's Call / WhatsApp,
  the same view a customer's order gets. Shown only when Theme settings →
  "J&T AWB lookup panel" is on.

  To remove: delete this file, its render line in sections/oka-orders.liquid,
  the test_panel setting, and testLookup() in assets/oka-screens.js.
{%- endcomment -%}
<div class="test-panel" data-test-lookup>
  <div class="test-badge">TESTING — staff only</div>
  {%- if settings.jt_tracking_url == blank or settings.jt_tracking_key == blank -%}
    <div class="error-txt">Fill in Theme settings → Live J&amp;T tracking first.</div>
  {%- endif -%}
  <label class="field-label">Customer phone or J&amp;T AWB numbers</label>
  <textarea class="field-input" data-tl-awbs dir="ltr" rows="2" autocomplete="off" placeholder="01012345678 — or — JEG000547822212, JEG…"></textarea>
  <label class="field-label">Look back (phone search)</label>
  <select class="field-input" data-tl-days>
    <option value="7">7 days</option>
    <option value="14">14 days</option>
    <option value="30" selected>30 days</option>
    <option value="60">60 days</option>
  </select>
  <div class="test-actions">
    <button class="cta bold" data-tl-go>Track</button>
    <button class="outline-btn" data-tl-clear>Clear</button>
  </div>
  <div class="error-txt" data-tl-error hidden></div>
</div>
<div data-tl-results></div>
