{%- comment -%} GridCard — the 2-up card used by collections, search and the wishlist. {%- endcomment -%}
{%- assign v = p.selected_or_first_available_variant -%}
<div class="gcard" data-item data-price="{{ v.price | divided_by: 100.0 }}" data-avail="{{ p.available }}" data-sale="{% if v.compare_at_price > v.price %}true{% else %}false{% endif %}" data-idx="{{ idx }}">
  <a href="{{ p.url }}" class="gcard-img">
    {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: p.title, sizes: '50vw' }}{%- endif -%}
  </a>
  <div class="gcard-body">
    <a href="{{ p.url }}" class="gcard-title">{% render 'ptitle', p: p %}</a>
    <div class="gcard-row">
      <span class="gcard-price">{% render 'price', cents: v.price %}</span>
      <button class="gcard-add" data-add="{{ v.id }}" {% unless p.available %}data-soldout{% endunless %}>{% render 'bi', en: 'Add', ar: 'عبيلي فالشنطة' %}</button>
    </div>
  </div>
</div>
