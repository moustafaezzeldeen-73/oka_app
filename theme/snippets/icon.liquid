{%- comment -%}
  Every path is copied verbatim from app/src/components/Icons.js.
  Usage: {% render 'icon', name: 'cart', px: 25 %}  — strokes follow currentColor unless `color` is given.
{%- endcomment -%}
{%- assign c = color | default: 'currentColor' -%}
{%- case name -%}
  {%- when 'chevron-left' -%}
    <svg width="{{ px | default: 18 }}" height="{{ px | default: 18 }}" viewBox="0 0 24 24" fill="none"><path d="M17 4l-8 8 8 8" stroke="{{ c }}" stroke-width="{{ width | default: 2.2 }}" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-right' -%}
    <svg width="{{ px | default: 16 }}" height="{{ px | default: 16 }}" viewBox="0 0 24 24" fill="none"><path d="M9 4l8 8-8 8" stroke="{{ c }}" stroke-width="{{ width | default: 2 }}" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'tag' -%}
    <svg width="{{ px | default: 24 }}" height="{{ px | default: 24 }}" viewBox="0 0 24 24" fill="none"><path d="M6.5 5h6.1a2 2 0 011.42.59l5.4 5.4a2 2 0 010 2.83l-5.6 5.6a2 2 0 01-2.83 0l-5.4-5.4A2 2 0 015 12.6V6.5A1.5 1.5 0 016.5 5z" stroke="{{ c }}" stroke-width="1.8" stroke-linejoin="round"/><circle cx="9.4" cy="9.4" r="1.5" fill="{{ c }}"/></svg>
  {%- when 'cube' -%}
    <svg width="{{ px | default: 15 }}" height="{{ px | default: 15 }}" viewBox="0 0 24 24" fill="none"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" stroke="{{ c }}" stroke-width="1.7" stroke-linejoin="round"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9" stroke="{{ c }}" stroke-width="1.7" stroke-linejoin="round"/></svg>
  {%- when 'heart' -%}
    <svg width="{{ px | default: 18 }}" height="{{ px | default: 18 }}" viewBox="0 0 24 24" fill="none" class="heart"><path d="M12 20s-7-4.4-9.5-9C.7 7.4 3 4 6.5 4 8.7 4 10.6 5.2 12 7c1.4-1.8 3.3-3 5.5-3 3.5 0 5.8 3.4 4 7-2.5 4.6-9.5 9-9.5 9z" stroke="{{ c }}" stroke-width="1.6"/></svg>
  {%- when 'cart' -%}
    <svg width="{{ px | default: 25 }}" height="{{ px | default: 25 }}" viewBox="0 0 24 24" fill="none"><path d="M3 4h2l2.4 12.2a2 2 0 002 1.8h8.4a2 2 0 002-1.7L21 8H6" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="21" r="1.4" fill="{{ c }}"/><circle cx="17" cy="21" r="1.4" fill="{{ c }}"/></svg>
  {%- when 'home' -%}
    <svg width="{{ px | default: 25 }}" height="{{ px | default: 25 }}" viewBox="0 0 24 24" fill="none"><path d="M3 11L12 4l9 7" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 10v9a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1v-9" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'box' -%}
    <svg width="{{ px | default: 25 }}" height="{{ px | default: 25 }}" viewBox="0 0 24 24" fill="none"><path d="M4 7l8-4 8 4v10l-8 4-8-4V7z" stroke="{{ c }}" stroke-width="1.8" stroke-linejoin="round"/><path d="M4 7l8 4 8-4M12 11v10" stroke="{{ c }}" stroke-width="1.8" stroke-linejoin="round"/></svg>
  {%- when 'person' -%}
    <svg width="{{ px | default: 25 }}" height="{{ px | default: 25 }}" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.6" stroke="{{ c }}" stroke-width="1.8"/><path d="M4.5 20c1.4-3.8 4.4-6 7.5-6s6.1 2.2 7.5 6" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- when 'check' -%}
    <svg width="{{ px | default: 28 }}" height="{{ px | default: 28 }}" viewBox="0 0 24 24" fill="none"><path d="M4 12l6 6L20 6" stroke="{{ color | default: '#ffffff' }}" stroke-width="{{ width | default: 3 }}" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'close' -%}
    <svg width="{{ px | default: 15 }}" height="{{ px | default: 15 }}" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="{{ c }}" stroke-width="{{ width | default: 2 }}" stroke-linecap="round"/></svg>
  {%- when 'plus' -%}
    <svg width="{{ px | default: 16 }}" height="{{ px | default: 16 }}" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="{{ c }}" stroke-width="{{ width | default: 2 }}" stroke-linecap="round"/></svg>
  {%- when 'crosshair' -%}
    <svg width="{{ px | default: 15 }}" height="{{ px | default: 15 }}" viewBox="0 0 24 24" fill="none"><path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="{{ c }}" stroke-width="1.9" stroke-linecap="round"/><circle cx="12" cy="12" r="5.2" stroke="{{ c }}" stroke-width="1.9"/><circle cx="12" cy="12" r="1.6" fill="{{ c }}"/></svg>
  {%- when 'pin' -%}
    <svg width="{{ px | default: 30 }}" height="{{ px | default: 30 }}" viewBox="0 0 24 24" fill="none"><path d="M12 22s7-6.2 7-12A7 7 0 005 10c0 5.8 7 12 7 12z" fill="#1d1d1f"/><circle cx="12" cy="10" r="2.6" fill="#ffffff"/></svg>
  {%- when 'ar-cross' -%}
    <svg width="{{ px | default: 12 }}" height="{{ px | default: 12 }}" viewBox="0 0 24 24" fill="none"><path d="M12 3v18M3 12h18" stroke="{{ color | default: '#ffffff' }}" stroke-width="1.9" stroke-linecap="round"/></svg>
  {%- when 'phone' -%}
    <svg width="{{ px | default: 15 }}" height="{{ px | default: 15 }}" viewBox="0 0 24 24" fill="none"><path d="M7.5 3.5h-2A2.5 2.5 0 003 6c0 8.28 6.72 15 15 15a2.5 2.5 0 002.5-2.5v-2a1 1 0 00-.76-.97l-3.6-.9a1 1 0 00-1 .32l-1.1 1.32a12.5 12.5 0 01-5.63-5.63l1.32-1.1a1 1 0 00.32-1l-.9-3.6a1 1 0 00-.97-.76z" fill="{{ color | default: '#ffffff' }}"/></svg>
  {%- when 'whatsapp' -%}
    <svg width="{{ px | default: 15 }}" height="{{ px | default: 15 }}" viewBox="0 0 24 24" fill="none"><path d="M12 2.5a9.5 9.5 0 00-8.2 14.28L2.5 21.5l4.85-1.26A9.5 9.5 0 1012 2.5zm0 1.9a7.6 7.6 0 016.45 11.6l-.23.37.62 2.26-2.33-.6-.36.21A7.6 7.6 0 1112 4.4z" fill="{{ color | default: '#ffffff' }}"/><path d="M9.3 7.6c-.18-.42-.37-.43-.55-.44h-.46a.9.9 0 00-.65.3 2.7 2.7 0 00-.84 2 4.7 4.7 0 001 2.5 10.6 10.6 0 004.05 3.56c2 .79 2.42.63 2.85.59a2.44 2.44 0 001.63-1.15 2 2 0 00.14-1.15c-.06-.1-.22-.16-.46-.28s-1.42-.7-1.64-.78-.38-.12-.55.12-.62.78-.76.94-.28.18-.52.06a6.5 6.5 0 01-1.9-1.18 7.2 7.2 0 01-1.33-1.65c-.14-.24 0-.37.1-.49s.24-.28.36-.42a1.6 1.6 0 00.24-.4.44.44 0 000-.42c-.06-.12-.54-1.32-.75-1.8z" fill="{{ color | default: '#ffffff' }}"/></svg>
  {%- when 'mastercard' -%}
    <svg width="28" height="20" viewBox="0 0 28 20"><rect x="0" y="0" width="28" height="20" rx="4" fill="#ffffff"/><circle cx="12" cy="10" r="5.5" fill="#eb001b"/><circle cx="16" cy="10" r="5.5" fill="#f79e1b" fill-opacity="0.9"/></svg>
  {%- when 'search' -%}
    <svg width="{{ px | default: 16 }}" height="{{ px | default: 16 }}" viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5" stroke="{{ c }}" stroke-width="{{ width | default: 2.2 }}"/><path d="M15.5 15.5L20 20" stroke="{{ c }}" stroke-width="{{ width | default: 2.2 }}" stroke-linecap="round"/></svg>
  {%- when 'menu' -%}
    <svg width="{{ px | default: 20 }}" height="{{ px | default: 20 }}" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h10" stroke="{{ c }}" stroke-width="{{ width | default: 2 }}" stroke-linecap="round"/></svg>
  {%- when 'grid' -%}
    <svg width="{{ px | default: 20 }}" height="{{ px | default: 20 }}" viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="6.5" height="6.5" rx="1.6" stroke="{{ c }}" stroke-width="1.8"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6" stroke="{{ c }}" stroke-width="1.8"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6" stroke="{{ c }}" stroke-width="1.8"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6" stroke="{{ c }}" stroke-width="1.8"/></svg>
  {%- when 'star' -%}
    <svg width="{{ px | default: 20 }}" height="{{ px | default: 20 }}" viewBox="0 0 24 24" fill="none"><path d="M12 3.8l2.5 5.1 5.6.8-4 3.9.9 5.6-5-2.6-5 2.6.9-5.6-4-3.9 5.6-.8L12 3.8z" stroke="{{ c }}" stroke-width="1.7" stroke-linejoin="round"/></svg>
  {%- when 'repeat' -%}
    <svg width="{{ px | default: 20 }}" height="{{ px | default: 20 }}" viewBox="0 0 24 24" fill="none"><path d="M17 3l3 3-3 3" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 11V9a3 3 0 013-3h13" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round"/><path d="M7 21l-3-3 3-3" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 13v2a3 3 0 01-3 3H4" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- when 'chat' -%}
    <svg width="{{ px | default: 20 }}" height="{{ px | default: 20 }}" viewBox="0 0 24 24" fill="none"><path d="M5 5h14a1 1 0 011 1v9a1 1 0 01-1 1H10l-4 3.5V16H5a1 1 0 01-1-1V6a1 1 0 011-1z" stroke="{{ c }}" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 9.5h8M8 12.5h5" stroke="{{ c }}" stroke-width="1.8" stroke-linecap="round"/></svg>
{%- endcase -%}
