{%- comment -%}
  The before / after slider from the original website (the one above the
  Cobra collection), full screen. Drag the handle — or anywhere on the
  picture, sideways — to compare; vertical swipes still scroll the feed.
  It nudges itself once when it comes into view, so it reads as a slider.
  Behaviour: assets/oka-screens.js (compare()).
  Usage: {% render 'compare-page', block: block %}
{%- endcomment -%}
{%- liquid
  assign a = block.settings.before_image
  assign b = block.settings.after_image
  assign link = block.settings.link | default: block.settings.before.url
-%}
{%- if a and b -%}
  <section class="page compare-page" data-banner data-compare style="--pos: 50%; --ratio: {{ a.aspect_ratio }}" {{ block.shopify_attributes }}>
    <div class="compare-frame">
      {{ b | image_url: width: 1200 | image_tag: alt: b.alt, class: 'compare-img', loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 431px) 430px, 100vw', draggable: 'false' }}
      <div class="compare-before" aria-hidden="true">
        {{ a | image_url: width: 1200 | image_tag: alt: '', class: 'compare-img', loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 431px) 430px, 100vw', draggable: 'false' }}
      </div>
      <div class="compare-line" aria-hidden="true"><span class="compare-knob">{% render 'icon', name: 'chevron-left', px: 14 %}{% render 'icon', name: 'chevron-right', px: 14 %}</span></div>
      <input class="compare-range" type="range" min="0" max="100" value="50" data-compare-range aria-label="Compare before and after">
    </div>
    {%- if link != blank -%}
      <a href="{{ link }}" class="offer-cta banner-cta">{% render 'bi', en: 'Shop now', ar: 'تسوّق الآن' %}</a>
    {%- endif -%}
  </section>
{%- endif -%}
