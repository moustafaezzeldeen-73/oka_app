# OKA app (Expo). Copied to app/.env by `npm run setup`.
# Everything here is bundled into the app and readable by anyone who has it:
# public values only. Secrets belong in server/.env.

# Base URL of the order service in server/. Leave blank when using
# `npm run dev`: it fills this in with an address your phone can reach.
EXPO_PUBLIC_OKA_SERVICE_URL=

# TESTING ONLY: shows the "sign in as a customer" panel on the sign-in screen.
# Delete before launch (see server/auth/testLogin.js).
EXPO_PUBLIC_TEST_LOGIN=1

# Optional: the Storefront API public token, used only for the live cart.
EXPO_PUBLIC_SHOPIFY_DOMAIN=www.okaegypt.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
