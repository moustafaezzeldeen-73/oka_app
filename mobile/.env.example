# ---------------------------------------------------------------------------
# OKA Warehouse — mobile app config
#
# Copy to `.env` in this folder. Expo reads EXPO_PUBLIC_* automatically.
#
# WARNING: every EXPO_PUBLIC_* value is INLINED INTO THE APP BUNDLE. Anyone
# with the APK can read it. That is fine for a URL and not fine for a Shopify
# Admin token — which is why "backend" is the default mode.
# ---------------------------------------------------------------------------

# backend (recommended) | direct | leave unset for sample data
EXPO_PUBLIC_MODE=backend

# --- backend mode -----------------------------------------------------------
# The Node service at the repo root. On a physical phone this must be your
# machine's LAN IP, not localhost — the phone resolves localhost to itself.
#   Windows: `ipconfig` -> IPv4 Address
EXPO_PUBLIC_API_BASE=http://192.168.1.10:3000

# --- direct mode (no server; credentials ship inside the app) ---------------
# EXPO_PUBLIC_SHOPIFY_SHOP=your-store
# EXPO_PUBLIC_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_SHOPIFY_API_VERSION=2025-07
# EXPO_PUBLIC_BOSTA_API_KEY=
# EXPO_PUBLIC_BOSTA_BASE_URL=https://app.bosta.co/api/v2
