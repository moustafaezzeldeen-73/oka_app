# ── App (bundled into the client — public values only) ────────────────────
# Base URL of the order service in server/. Leave blank to run the app purely
# on its bundled catalogue.
EXPO_PUBLIC_OKA_SERVICE_URL=

# Optional: the Storefront API public token, used only for the live cart.
EXPO_PUBLIC_SHOPIFY_DOMAIN=www.okaegypt.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# ── Order service (server/.env only — NEVER bundled into the app) ─────────
# These grant full control of the store and the courier accounts. Put them in
# server/.env (gitignored) or the service's hosting environment; never in
# app.json or any EXPO_PUBLIC_* variable.

# Shopify Admin API. The older names SHOPIFY_SHOP_DOMAIN / SHOPIFY_ADMIN_TOKEN
# are still accepted.
SHOPIFY_STORE_DOMAIN=756009.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# J&T Express Egypt — the current courier.
JT_API_BASE_URL=https://openapi.jtjms-eg.com/webopenplatformapi
JT_API_ACCOUNT=
JT_PRIVATE_KEY=
JT_CUSTOMER_CODE=
JT_CUSTOMER_PASSWORD=

# Bosta — optional; keeps tracking history for orders shipped before J&T.
BOSTA_BASE_URL=https://app.bosta.co/api/v2
BOSTA_API_KEY=

# Testing-only sign-in (see server/auth.js).
STAFF_MASTER_PASSWORD=0000
PORT=8787
ALLOWED_ORIGIN=
