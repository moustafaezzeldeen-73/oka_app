# ── App (bundled into the client — public values only) ────────────────────
# Base URL of the order service in server/. Leave blank to run the app purely
# on its bundled catalogue.
EXPO_PUBLIC_OKA_SERVICE_URL=

# TESTING ONLY: shows the "sign in as a customer" panel on the sign-in screen.
# Delete before launch (see server/testLogin.js).
EXPO_PUBLIC_TEST_LOGIN=1

# Optional: the Storefront API public token, used only for the live cart.
EXPO_PUBLIC_SHOPIFY_DOMAIN=www.okaegypt.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# ── Order service (server/.env only — NEVER bundled into the app) ─────────
# These grant full control of the store and the courier accounts. Put them in
# server/.env (gitignored) or the service's hosting environment; never in
# app.json or any EXPO_PUBLIC_* variable.

# Shopify Admin API. The older names SHOPIFY_SHOP_DOMAIN / SHOPIFY_ADMIN_TOKEN
# are still accepted.
SHOPIFY_STORE_DOMAIN=756009.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# J&T Express Egypt — the current courier.
JT_API_BASE_URL=https://openapi.jtjms-eg.com/webopenplatformapi
JT_API_ACCOUNT=
JT_PRIVATE_KEY=
JT_CUSTOMER_CODE=
JT_CUSTOMER_PASSWORD=

# Bosta — optional; keeps tracking history for orders shipped before J&T.
BOSTA_BASE_URL=https://app.bosta.co/api/v2
BOSTA_API_KEY=

# ── Sessions ──────────────────────────────────────────────────────────────
# Required in production: at least 32 random characters
# (e.g. `openssl rand -hex 32`). Unset in development = a random secret per
# process, so sessions end when the server restarts.
SESSION_SECRET=
SESSION_TTL_DAYS=30

# ── Phone sign-in (one-time codes) ────────────────────────────────────────
# whatsapp | console. "console" prints codes in the server log and is refused
# when NODE_ENV=production.
OTP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar

# ── TESTING ONLY: sign in as any real customer — delete before launch ─────
# At least 16 characters. The tester types it into the app; it is never
# bundled. Ignored when NODE_ENV=production. See server/testLogin.js.
TEST_LOGIN_KEY=

# Staff-only /debug/* routes (header x-staff-key). At least 16 characters;
# unset = the routes answer 404.
STAFF_DEBUG_KEY=

# ── Commercial policy (defaults shown; see server/policy.js) ──────────────
# Shipping fees aren't set here: the app charges the store's own Shopify
# rates, the same as the website.
# The website has no minimum order; 0 matches it.
MIN_ORDER_EGP=150
PREPAID_SHIPPING_DISCOUNT_EGP=10
SUBSCRIPTION_DISCOUNT_PCT=5
# 1 point per EGP = 10% back (10 points = 1 EGP)
LOYALTY_EARN_POINTS_PER_EGP=1
LOYALTY_VOUCHER_DAYS=90
# Points are only credited for orders created on/after this date (YYYY-MM-DD).
# Unset = the earning job does nothing.
LOYALTY_START_DATE=
# Name of the connected card/wallet gateway. Unset = cash on delivery only.
PAYMENT_GATEWAY=

# ── Background jobs ───────────────────────────────────────────────────────
# Set to false on every instance but one.
JOBS_ENABLED=true
# Point at a persistent disk in production.
SUBSCRIPTIONS_DATA_DIR=
# Optional: Expo access token for push notifications (if your project requires one).
EXPO_ACCESS_TOKEN=

# ── Support ───────────────────────────────────────────────────────────────
SUPPORT_WHATSAPP=
POLICIES_BASE_URL=https://www.okaegypt.com/policies

NODE_ENV=development
PORT=8787
# 1 when running behind a proxy/load balancer (Render, Fly, Nginx); 0 otherwise.
TRUST_PROXY_HOPS=1
ALLOWED_ORIGIN=
