# ---------------------------------------------------------------------------
# OKA Warehouse App — credentials
#
# Copy to `.env` and fill in. Never commit the filled-in file; `.env` is
# gitignored. Every value here is read once at boot by src/config.js.
# ---------------------------------------------------------------------------

# --- Shopify Admin API ------------------------------------------------------
# Store handle only, no protocol and no trailing slash (e.g. oka-egypt).
SHOPIFY_SHOP=your-store
# Admin API access token from a custom app in the Shopify admin
# (Settings -> Apps and sales channels -> Develop apps). Starts with `shpat_`.
# Required scopes — confirmed by validating this app's actual order query
# against the live schema. The fulfillment-order scopes are easy to miss and
# are NOT optional: the order query reads `fulfillments { trackingInfo }` to
# find each Bosta AWB, and without them the whole query 403s rather than just
# omitting that field.
#   read_orders, write_orders
#   read_customers, write_customers
#   read_products
#   read_fulfillments, write_fulfillments
#   read_assigned_fulfillment_orders
#   read_merchant_managed_fulfillment_orders
#   read_third_party_fulfillment_orders
#   read_shipping
#   write_metafields          (call transcripts on the order)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07

# --- Bosta ------------------------------------------------------------------
# API key from the Bosta dashboard (Settings -> Integrations -> API key).
# Sent verbatim in the `Authorization` header — Bosta does NOT use `Bearer`.
BOSTA_API_KEY=
BOSTA_BASE_URL=https://app.bosta.co/api/v2
# Pickup location id for the OKA warehouse, from GET /pickup-locations.
# Leave blank to let Bosta fall back to the business default pickup address.
BOSTA_PICKUP_LOCATION_ID=

# --- App --------------------------------------------------------------------
PORT=3000
# Cairo is UTC+2 year-round (no DST since 2014's reinstatement was dropped
# again in 2023) — used for the today/yesterday order window.
ORDER_WINDOW_TZ_OFFSET_HOURS=2
# Guard rail: creating a Bosta delivery is a real, billable shipment. With
# this on, /api/shipments only ever runs in dry-run mode regardless of what
# the request asks for. Turn it off deliberately when you mean to ship.
BOSTA_LIVE_SHIPMENTS=false

# --- Gemini (call transcription) --------------------------------------------
# Server-side only. Never expose this to the app: an EXPO_PUBLIC_* value is
# inlined into the bundle and extractable from the APK.
# Audio is billed per second, so transcription is idempotent on call id and
# never repeats for the same recording.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Call history + recordings ----------------------------------------------
# Which backend supplies call history. See src/lib/callProvider.js and
# docs/call-recording.md.
#   salestrail | voip | device | none
# The mobile app prefers the handset's own call log when it can read it (a dev
# build), and only falls back to this server-side provider otherwise.
CALL_PROVIDER=salestrail

# --- Salestrail (only when CALL_PROVIDER=salestrail) -------------------------
# The app does NOT record calls itself — Android blocks that for third-party
# apps (see docs/call-recording.md). Salestrail's own Android app records them;
# this reads what it captured.
SALESTRAIL_API_KEY=
SALESTRAIL_BASE_URL=https://api.salestrail.io
# Header the API key is sent in. Confirm against your Salestrail account before
# first use — a wrong header shows up as an opaque 401.
SALESTRAIL_AUTH_HEADER=x-api-key
