# ── App (bundled into the client — public values only) ────────────────────
# The Storefront API public access token is designed to be shipped in a client.
# It can read published products/collections and manage carts, nothing else.
EXPO_PUBLIC_SHOPIFY_DOMAIN=www.okaegypt.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Base URL of the order service in server/. Leave blank to run the app purely
# on its bundled catalogue.
EXPO_PUBLIC_OKA_SERVICE_URL=

# ── Order service (server/ only — NEVER bundled into the app) ─────────────
# These grant full control of the store and the courier account. Set them in
# the service's hosting environment; do not put them in app.json or any
# EXPO_PUBLIC_* variable.
SHOPIFY_SHOP_DOMAIN=okaegypt.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07
BOSTA_API_KEY=
PORT=8787
ALLOWED_ORIGIN=
